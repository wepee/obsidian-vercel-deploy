{
	"name": "obsidian-vercel-deploy",
	"version": "1.1.0",
	"description": "Share HTML files and folders from Obsidian on Vercel, all in one project, one subdomain per share.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
	},
	"author": "Adam",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "5.1.6"
	}
}
